<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/v2box_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/group_icon"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/v2box_accent"
            android:textSize="21sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
            <TextView
                android:id="@+id/group_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="start"
                android:textDirection="firstStrong"
                android:textColor="@color/v2box_text"
                android:textSize="15sp" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/group_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:indicatorColor="@color/v2box_accent"
                app:trackColor="@color/v2box_control" />
            <TextView
                android:id="@+id/group_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:gravity="start"
                android:textDirection="locale"
                android:textColor="@color/v2box_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/group_ping"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/title_real_ping_all_server">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_v2box_speed" android:contentDescription="@null"
                app:tint="@color/v2box_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/v2box_group_ping"
                android:textSize="10sp" android:textColor="@color/v2box_accent" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/group_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/notification_action_more"
            >
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_more_vert_24dp" android:contentDescription="@null"
                app:tint="@color/v2box_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/v2box_group_actions"
                android:textSize="10sp" android:textColor="@color/v2box_muted" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
