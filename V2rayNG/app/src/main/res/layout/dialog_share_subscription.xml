<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/subscription_qr"
                android:layout_width="match_parent"
                android:layout_height="232dp"
                android:layout_margin="12dp"
                android:contentDescription="@string/title_qr_code"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/v2box_subscription_link"
            android:textColor="@color/v2box_muted"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/v2box_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/subscription_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:gravity="start"
                android:padding="14dp"
                android:textColor="@color/v2box_text"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_subscription_url"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="@string/v2box_copy_subscription_link"
            android:textSize="13sp"
            app:backgroundTint="@color/v2box_accent"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:iconSize="18dp" />
    </LinearLayout>
</ScrollView>
